# Firebase Emulator Configuration
# Copy this file to .env.local and set NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true to use local emulators

# Enable Firebase Emulators (set to 'true' for local development)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Emulator will use these ports (configured in firebase.json):
# - Firestore: localhost:8080
# - Auth: localhost:9099
# - Emulator UI: localhost:4000
